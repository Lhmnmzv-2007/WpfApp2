<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="Threads Table" Height="450" Width="800">
    <Window.Icon>/Şir və Tac_ Səfəvi Gerbi.png</Window.Icon>
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF71FAFA"/>
            <GradientStop Color="#FF519E5B" Offset="1"/>
            <GradientStop Color="#FFFF6B6B" Offset="0.485"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid Background="#cccccc" Margin="15">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Working Threads" Grid.Row="0" Grid.Column="0" FontWeight="Bold" HorizontalAlignment="Center"/>
        <Label Content="Waiting Threads" Grid.Row="0" Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Center"/>
        <Label Content="Created Threads" Grid.Row="0" Grid.Column="2" FontWeight="Bold" HorizontalAlignment="Center"/>

        <ListBox x:Name="listBox1" Grid.Row="1" Grid.Column="0" Margin="5" MouseDoubleClick="listBox1_MouseDoubleClick_1" Background="#FFDDF3FC"/>
        <ListBox x:Name="listBox2" Grid.Row="1" Grid.Column="1" Margin="5" Background="#FFFFE8E8"/>
        <ListBox x:Name="listBox3" Grid.Row="1" Grid.Column="2" Margin="5" MouseDoubleClick="listBox3_MouseDoubleClick_2">
            <ListBox.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFE2FFDE" Offset="0.009"/>
                    <GradientStop Color="#FFBFE3BA" Offset="1"/>
                </LinearGradientBrush>
            </ListBox.Background>
        </ListBox>

        <Label Content="Places In Semaphore" Grid.Row="2" Grid.Column="0" Margin="0,5,0,0"/>

        <Grid Grid.Row="3" Grid.Column="0" HorizontalAlignment="Left" Margin="5,0,5,5" Width="90">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="15"/>
                <RowDefinition Height="15"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="textBox1" Text="1" Grid.Column="0" Grid.RowSpan="2" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

            <Button x:Name="button1" Content="▲" Grid.Column="1" Grid.Row="0" FontSize="8" Click="button1_Click"/>
            <Button x:Name="button2" Content="▼" Grid.Column="1" Grid.Row="1" FontSize="8" Click="button2_Click"/>
        </Grid>

        <Button x:Name="button3" Content="Create New" Grid.Row="3" Grid.Column="2" Margin="5" Width="100" Height="30" HorizontalAlignment="Right" Click="button3_Click"/>
    </Grid>
</Window>
